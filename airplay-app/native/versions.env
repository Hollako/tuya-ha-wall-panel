# Pinned versions and download URLs for native components
# SHA256 checksums will be computed during build for verification

# shairport-sync 5.6.1 (MIT license)
SHAIRPORT_SYNC_VERSION=5.6.1
SHAIRPORT_SYNC_URL="https://github.com/mikebrady/shairport-sync/archive/refs/tags/5.6.1.tar.gz"

# nqptp 1.2.9 (GPL-2.0 license)
NQPTP_VERSION=1.2.9
NQPTP_URL="https://github.com/mikebrady/nqptp/archive/refs/tags/1.2.9.tar.gz"

# FFmpeg n8.1 (LGPL-2.1 license)
FFMPEG_VERSION=n8.1
FFMPEG_URL="https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n8.1.tar.gz"

# OpenSSL 3.0.13 (Apache-2.0 license)
OPENSSL_VERSION=3.0.13
OPENSSL_URL="https://www.openssl.org/source/openssl-3.0.13.tar.gz"

# libsodium 1.0.19 (ISC license)
LIBSODIUM_VERSION=1.0.19
LIBSODIUM_URL="https://download.libsodium.org/libsodium/releases/libsodium-1.0.19.tar.gz"

# libconfig 1.7.3 (LGPL-2.1 license)
LIBCONFIG_VERSION=1.7.3
LIBCONFIG_URL="https://github.com/hyperrealm/libconfig/releases/download/v1.7.3/libconfig-1.7.3.tar.gz"

# popt 1.19 (MIT license)
POPT_VERSION=1.19
POPT_URL="https://ftp.osuosl.org/pub/blfs/conglomeration/popt/popt-1.19.tar.gz"

# libxml2 2.11.7 (MIT license)
LIBXML2_VERSION=2.11.7
LIBXML2_URL="https://download.gnome.org/sources/libxml2/2.11/libxml2-2.11.7.tar.xz"

# libplist 2.3.0 (LGPL-2.1 license)
LIBPLIST_VERSION=2.3.0
LIBPLIST_URL="https://github.com/libimobiledevice/libplist/releases/download/2.3.0/libplist-2.3.0.tar.bz2"

# libgpg-error 1.47 (LGPL-2.1 license)
LIBGPG_ERROR_VERSION=1.47
LIBGPG_ERROR_URL="https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-1.47.tar.bz2"

# libgcrypt 1.10.3 (LGPL-2.1 license)
LIBGCRYPT_VERSION=1.10.3
LIBGCRYPT_URL="https://www.gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-1.10.3.tar.bz2"

# musl cross-compilation toolchains (from musl.cc)
MUSL_CC_AARCH64_URL="https://musl.cc/aarch64-linux-musl-cross.tgz"
MUSL_CC_ARMV7L_URL="https://musl.cc/armv7l-linux-musleabihf-cross.tgz"
